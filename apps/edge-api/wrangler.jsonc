{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "balo-pilot-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["13 3 * * *"]
  },
  "secrets": {
    "required": ["BUILD_CALLBACK_SECRET", "BUILD_EXPORT_SECRET", "CSRF_SECRET", "GATEWAY_HMAC_SECRET", "GATEWAY_URL", "GITHUB_DISPATCH_TOKEN", "MEDIA_INTENT_SECRET", "TURNSTILE_SECRET"]
  },
  "r2_buckets": [
    { "binding": "PRIVATE_MEDIA", "bucket_name": "balo-private-media" },
    { "binding": "PUBLIC_MEDIA", "bucket_name": "balo-public-media" }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:5173",
    "ALLOW_TEST_BYPASS": "false",
    "MEDIA_BACKEND": "local",
    "MEDIA_PUBLIC_BASE_URL": "http://localhost:8787/v1/public/media",
    "GITHUB_REPOSITORY": "",
    "GITHUB_WORKFLOW": "",
    "GITHUB_REF": "dev",
    "OPS_ALLOWED_ORIGIN": "http://localhost:5174",
    "POLICY_AUD": "",
    "RUNTIME_ENV": "development",
    "TEAM_DOMAIN": ""
  },
  "env": {
    "staging": {
      "name": "balo-pilot-api-staging",
      "secrets": {
        "required": ["BUILD_CALLBACK_SECRET", "BUILD_EXPORT_SECRET", "CSRF_SECRET", "GATEWAY_HMAC_SECRET", "GATEWAY_URL", "GITHUB_DISPATCH_TOKEN", "MEDIA_INTENT_SECRET", "TURNSTILE_SECRET"]
      },
      "r2_buckets": [
        { "binding": "PRIVATE_MEDIA", "bucket_name": "balo-private-media-staging" },
        { "binding": "PUBLIC_MEDIA", "bucket_name": "balo-public-media-staging" }
      ],
      "vars": {
        "ALLOWED_ORIGIN": "https://staging.example.invalid",
        "ALLOW_TEST_BYPASS": "false",
        "MEDIA_BACKEND": "local",
        "MEDIA_PUBLIC_BASE_URL": "https://staging.example.invalid/v1/public/media",
        "GITHUB_REPOSITORY": "",
        "GITHUB_WORKFLOW": "",
        "GITHUB_REF": "dev",
        "OPS_ALLOWED_ORIGIN": "https://ops.staging.example.invalid",
        "POLICY_AUD": "",
        "RUNTIME_ENV": "staging",
        "TEAM_DOMAIN": ""
      }
    },
    "production": {
      "name": "balo-pilot-api-production",
      "secrets": {
        "required": ["BUILD_CALLBACK_SECRET", "BUILD_EXPORT_SECRET", "CSRF_SECRET", "GATEWAY_HMAC_SECRET", "GATEWAY_URL", "GITHUB_DISPATCH_TOKEN", "MEDIA_INTENT_SECRET", "TURNSTILE_SECRET"]
      },
      "r2_buckets": [
        { "binding": "PRIVATE_MEDIA", "bucket_name": "balo-private-media" },
        { "binding": "PUBLIC_MEDIA", "bucket_name": "balo-public-media" }
      ],
      "vars": {
        "ALLOWED_ORIGIN": "https://example.invalid",
        "ALLOW_TEST_BYPASS": "false",
        "MEDIA_BACKEND": "local",
        "MEDIA_PUBLIC_BASE_URL": "https://example.invalid/v1/public/media",
        "GITHUB_REPOSITORY": "",
        "GITHUB_WORKFLOW": "",
        "GITHUB_REF": "main",
        "OPS_ALLOWED_ORIGIN": "https://ops.example.invalid",
        "POLICY_AUD": "",
        "RUNTIME_ENV": "production",
        "TEAM_DOMAIN": ""
      }
    }
  }
}
